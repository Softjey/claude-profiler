{
  "name": "claude-profiler",
  "version": "0.1.1",
  "description": "See where the time went in a Claude Code session: model vs tools vs approvals, per tool, per turn and per subagent, in a terminal UI.",
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "ai",
    "llm",
    "agent",
    "coding-agent",
    "profiler",
    "performance",
    "timing",
    "latency",
    "tokens",
    "context-window",
    "hooks",
    "transcript",
    "observability",
    "developer-tools",
    "cli",
    "tui",
    "terminal",
    "ink"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Softjey",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Softjey/claude-profiler.git"
  },
  "homepage": "https://github.com/Softjey/claude-profiler#readme",
  "bugs": {
    "url": "https://github.com/Softjey/claude-profiler/issues"
  },
  "bin": {
    "claude-profiler": "dist/cli/bin.js",
    "cprof": "dist/cli/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm run build && pnpm run test",
    "prepublishOnly": "pnpm verify"
  },
  "dependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "@types/react": "^19.2.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
